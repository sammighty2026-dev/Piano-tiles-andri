[app]
title = Piano Tiles
package.name = pianotiles
package.domain = org.sammighty
source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,atlas,ttf,wav,ogg

# Essential requirements for Pygame on Android
requirements = python3,pygame,sdl2_image,sdl2_mixer,sdl2_ttf,sdl2

orientation = portrait
fullscreen = 1

[buildozer]
log_level = 2
warn_on_root = 1
